# Backend configuration example. Copy to .env and replace every placeholder.
# Real secrets must never be committed (CONTRIBUTION.md §2).

# --- Database ---
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/mydatabase
# Apply app/schema.sql at startup (idempotent CREATE TABLE IF NOT EXISTS).
# An existing database is updated by the migrations in backend/migrations:
#   python -m app.migrate
AUTO_INIT_SCHEMA=true
DB_POOL_MIN=1
DB_POOL_MAX=10

# --- Security ---
# Tokens are signed with JWT_SECRET; FLASK_SECRET_KEY is used as a fallback.
JWT_SECRET=replace-with-a-long-random-string
FLASK_SECRET_KEY=replace-with-another-long-random-string
JWT_ALGORITHM=HS256
JWT_TTL_HOURS=12

# --- HTTP ---
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=INFO

# --- Recommendations ---
# Embeddings need the sentence-transformers model; keyword scoring is used when off.
EMBEDDINGS_ENABLED=false
EMBEDDING_MODEL=all-MiniLM-L6-v2
RECOMMENDATIONS_LIMIT=10

# --- Stub recommendation module (backend/app/ml) ---
# true switches /recommend_recipes to the stub pipeline of ml_planning/ml_plan
# (favourites + KNN + fridge); false keeps the baseline scoring.  LIMIT is the size of
# the answer, NEIGHBOURS is the number of recipes KNN looks at.
SMART_RECOMMENDATIONS_ENABLED=false
SMART_RECOMMENDATIONS_LIMIT=5
SMART_RECOMMENDATIONS_NEIGHBOURS=10

# --- Dataset import (python -m app.importer) ---
# The raw dataset is not committed (its licence is not stated). Either point the importer
# at a downloaded file/directory, or let it download the archive from Kaggle: the
# credentials are read from the environment only and are never written to the log.
POVARENOK_DATASET=data/povarenok
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Background worker (worker.py) ---
NOTIFY_INTERVAL_MINUTES=60
