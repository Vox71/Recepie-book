# Backend configuration example. Copy to .env and replace every placeholder.
# Real secrets must never be committed (CONTRIBUTION.md §2).

# --- Database ---
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/mydatabase
# Apply app/schema.sql at startup (idempotent CREATE TABLE IF NOT EXISTS).
# An existing database is updated by the migrations in backend/migrations:
#   python -m app.migrate
AUTO_INIT_SCHEMA=true
DB_POOL_MIN=1
DB_POOL_MAX=10

# --- Security ---
# Tokens are signed with JWT_SECRET; FLASK_SECRET_KEY is used as a fallback.
JWT_SECRET=replace-with-a-long-random-string
FLASK_SECRET_KEY=replace-with-another-long-random-string
JWT_ALGORITHM=HS256
JWT_TTL_HOURS=12

# --- HTTP ---
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=INFO

# --- Recommendations ---
# Embeddings need the sentence-transformers model; keyword scoring is used when off.
EMBEDDINGS_ENABLED=false
EMBEDDING_MODEL=all-MiniLM-L6-v2
RECOMMENDATIONS_LIMIT=10

# --- Background worker (worker.py) ---
NOTIFY_INTERVAL_MINUTES=60
