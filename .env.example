# docker-compose variables. Copy to .env in the repository root.
# The backend reads DATABASE_URL/JWT_SECRET/CORS_ORIGINS and friends from there.
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=mydatabase
DB_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=3000
SWAGGER_PORT=8080

FLASK_SECRET_KEY=changeme
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGINS=http://localhost:3000
AUTO_INIT_SCHEMA=true
EMBEDDINGS_ENABLED=false
LOG_LEVEL=INFO
